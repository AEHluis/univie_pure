# TYPO3 / Pure API connection
PURE_URI=https://www.example.edu/ws/
PURE_APIKEY=CHANGE_ME
PURE_ENDPOINT=api/524/

# Outbound proxy for all external HTTP requests from this extension
# LUH default: http://proxy.luis.uni-hannover.de:3128
PURE_PROXY=http://proxy.luis.uni-hannover.de:3128

# Enrichment feature flags
ENRICHMENT_UNPAYWALL_ENABLED=true

# External API identification
# Required by Unpaywall when enabled
UNPAYWALL_EMAIL=you@example.org
